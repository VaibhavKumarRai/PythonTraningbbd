def number():
    num1 = int(input("Enter first number: "))
    num2 = int(input("Enter second number: "))
    if num1 > num2:
        return f"{num1} is greater than {num2}"
    elif num2 > num1:
        return f"{num2} is greater than {num1}"
    else:
        return "Both numbers are equal"
print(number())
